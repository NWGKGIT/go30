// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String        @id @default(cuid())
  email      String        @unique
  createdAt  DateTime      @default(now())
  xp         Int           @default(0)
  streak     Int           @default(0)
  lastActive DateTime?
  pathSlug   String        @default("go-30")
  progress   DayProgress[]
}

model Path {
  slug        String          @id
  version     String
  title       String
  description String
  days        CurriculumDay[]
}

model CurriculumDay {
  id          String        @id @default(cuid())
  pathSlug    String
  slug        String // day-01, day-02, etc.
  dayNumber   Int
  phase       Int
  week        Int
  title       String
  description String
  xpReward    Int           @default(100)
  sortOrder   Int
  path        Path          @relation(fields: [pathSlug], references: [slug], onDelete: Cascade)
  tasks       Task[]
  progress    DayProgress[]

  @@unique([pathSlug, slug])
  @@unique([pathSlug, dayNumber])
  @@index([pathSlug, sortOrder])
}

model Task {
  id          String           @id @default(cuid())
  dayId       String
  slug        String // tour-basics, tgpl-ch1-2, etc.
  label       String
  type        TaskType
  url         String?
  sortOrder   Int
  day         CurriculumDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  completions TaskCompletion[]

  @@unique([dayId, slug])
  @@index([dayId, sortOrder])
}

model DayProgress {
  id            String           @id @default(cuid())
  userId        String
  dayId         String
  status        DayStatus        @default(LOCKED)
  completedAt   DateTime?
  xpEarned      Int              @default(0)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculumDay CurriculumDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  tasks         TaskCompletion[]
  journal       JournalEntry?
  snippets      CodeSnippet[]

  @@unique([userId, dayId])
  @@index([userId, status])
}

model TaskCompletion {
  id          String      @id @default(cuid())
  progressId  String
  taskId      String
  completedAt DateTime    @default(now())
  progress    DayProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([progressId, taskId])
}

model JournalEntry {
  id         String      @id @default(cuid())
  progressId String      @unique
  content    String      @default("")
  updatedAt  DateTime    @updatedAt
  progress   DayProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
}

model CodeSnippet {
  id         String      @id @default(cuid())
  progressId String
  title      String?
  code       String
  createdAt  DateTime    @default(now())
  progress   DayProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@index([progressId, createdAt])
}

enum TaskType {
  BOOK
  TOUR
  CODE
  MILESTONE
}

enum DayStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETE
}
